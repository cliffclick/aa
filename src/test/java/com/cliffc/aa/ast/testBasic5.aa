// Uses the display in a meaningful way (sorta).
// Intended to force keeping the display Parm alive in the functions and test display loading

// GCP: *[19]@{ _; A1=PA:*[18]@{ _; fld=int:nint8;... }; A7=PA; ...}
// HMT: *[19]@{ _; A1=   *[18]@{ _; fld=int:nint8;    }; A7=*[18]@{ _; fld=int:nint8; }; }

var := 1;
A_noinline = { -> @{ fld = var; } };
A1 = A_noinline();
var := 7;
@{ A1 = A1; A7 = A_noinline(); }
