// Uses the display in a meaningful way (sorta).
// Intended to force keeping the display Parm alive in the functions and test display loading

// GCP: *[23]@ {_; A1:=PA:*[22]@{ _; fld:=   nint8  }; A7:=PA                        }
// HMT: *[23]@ {_; A1=    *[22]@{ _; fld=int:nint8; }; A7=*[22]@{ _; fld=int:nint8;};}

var := 1;
A_noinline := { -> @{ fld = var; } };
x := A_noinline();
var := 7;
@{ A1 = x; A7 = A_noinline(); }
