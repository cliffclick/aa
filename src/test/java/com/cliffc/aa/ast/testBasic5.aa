// Uses the display in a meaningful way (sorta).
// Intended to force keeping the display Parm alive in the functions and test display loading

// GCP: *[23]@{A1=PA:*[22]@{fld=    nint8 };A7=PA                     }
// HMT: *[23]@{A1=   *[22]@{fld=int:nint8;};A7=*[22]@{fld=int:nint8;};}

var := 1;
A_noinline := { -> @{ fld = var; } };
x := A_noinline();
var := 7;
@{ A1 = x; A7 = A_noinline(); }
