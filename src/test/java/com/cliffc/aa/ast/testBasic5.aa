// Uses the display in a meaningful way (sorta).
// Intended to force keeping the display Parm alive in the functions and test display loading

// GCP: *[22]@{ _; A1=PA:*[21]@{ _; fld=    nint8};   A7= PA                          }
// HMT: *[22]@{ _; A1=   *[21]@{ _; fld=int:nint8; }; A7=*[21]@{ _; fld=int:nint8; }; }

var := 1;
A_noinline := { -> @{ fld = var; } };
A1 := A_noinline();
var := 7;
@{ A1 = A1; A7 = A_noinline(); }
