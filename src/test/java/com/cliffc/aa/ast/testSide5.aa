// Mutually recursive.
// Uses the display in a meaningful way (sorta).
// Intended to force keeping the display Parm alive in the functions, while
// keeping the types of {A,B} still polymorphic

// GCP: *[20]@{ _; init=int:7; rez0=*[18]@{ _; bfld=int:3; ...}; rez1=*[18]@{ _; bfld=int:7; ...}; ...}
// HMT: *[21]@{ _; init=int:7; }

init := 0;
A_noinline = { x -> @{ bfld = init; } };
rez0 = A_noinline(1.2);
init := 7;
rez1 = A_noinline(@{c=3; });
@{ rez0=rez0; rez1=rez1; init=init; }
