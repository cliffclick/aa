// FCN selects correct field/function based on multiple argument types
// GCP: *[25]( _, 0:=%[2,25][2]?, 1:=%[2,25][2]?)
// HMT: *[25](_,int:int64,flt:flt64)", null, null, "[4,25]", null)

noinline_foo = { x y ->
        ( { x y -> !x      * %y },
          { x y -> x.sin() * %y }
          )._(x,y)  // The single call site; "x" is either int or flt
};
(noinline_foo(3,5), noinline_foo(3.3,5))
