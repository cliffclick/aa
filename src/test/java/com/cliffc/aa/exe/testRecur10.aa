// Polymorphic records; see testRecur11.aa
// Type: *[NIL]( _, *[3]( _, *[INT]@{ x=int:3; y=int:4; }, int:3), *[3]( _, *[FLT]@{ x=int:4; z=*[8]@{ q=int:1; }; }, int:4))
// Eval: *[5]( _, *[3]( _, *[6]@{ x=3; y=4; }, 3), *[3]( _, *[7]@{ x=4; z=*[8]@{ q=1; }; }, 4))
fun = { rec ->
  (pair rec rec.x)
};
(pair
  (fun @{x =3  ; y =4       ; })
  (fun @{x =4  ; z =@{q =1;}; })
)
