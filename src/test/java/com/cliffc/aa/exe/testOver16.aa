// Type: *[8]( _, *[3]( _, int:int64, str:str), *[3]( _, int:int64, str:str))
// Eval: *[8]( _, *[3]( _, 124, "litered"), *[3]( _, 457, "liteblue"))
color = { hex name -> (pair hex name )};
red  = (color 123 "red" );
blue = (color 456 "blue");
lite = { c -> (color (+1 c._) (s+ "lite" c._))};
(pair (lite red) (lite blue))
