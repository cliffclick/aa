// Evil test, showing AA use of display.
// Type: *[11]@{ AD=int:1; Aflt=flt:3.100000001490116; }
// Eval: *[11]@{ Aflt=3.100000001490116f; AD=1; }

// All functions make field-local display loads ONLY, never "look" outside their own scope.

// Summary: It All Works

// Major Point: Ignore the "IMPLICIT_DSP", these shouldn't be used as part of
// typing - since never looking at external scopes.  The Explicit Display types
// are all sensible.


// IMPLICIT_DSP0: D:*[2]@{ $dyn=DYN; dsp0=C; dsp1=E:*[FLT]@{ D={ D DYN *[]@{ dsp0=F:*[]@{ A={ - - F 1 -> V306 };  ..., };  ..., } -> V306 }; dsp0=G:*[3]@{ A={ *[2]@{ $dyn=DYN; dsp0=G; dsp1=E;  ..., } DYN H:*[]@{ A={ - - H V295 -> V295 };  ..., } V295 -> V295 }; }; };  ..., }
// C:*[3]@{
//   Ignoring the implicit DSP, the *explicit* DSP preserves A is the ID function in the display
//   A={ IMPLICIT_DSP0 DYN I:*[]@{ A={ - - I V264 -> V264 };  ..., } V264 -> V264 };
// }
dsp0 = @{
  // These dsp0 come from LAMBDA, not Fresh.
  // Preserve A as ID function.
  A0 = { dsp0x x -> if (rnd) ? (dsp0x.A0 dsp0x x) : x }; // Recursive ID function
};


// IMPLICIT_DSP0: { D:*[2]@{ DYN; dsp0=*[3]@{ A={ D DYN I:*[]@{ A={ - - I V264 -> V264 };  ..., } V264 -> V264 }; }; dsp1=E;  ..., } DYN *[]@{ dsp0=F:*[]@{ A={ - - F 1 -> V306 };  ..., };  ..., } -> V306 }
// NEST_IMPLICIT_DSP0: *[2]@{ DYN; dsp0=G; dsp1=E;  ..., }
dsp1 = @{
  // E:*[FLT]@{
  //   D=IMPLICIT_DSP0;
  //   dsp0=G:*[3]@{
  //     A={ NEST_IMPLICIT_DSP0 DYN H:*[]@{ A={ - - H V295 -> V295 };  ..., } V295 -> V295 };
  //   };
  // }
  dsp0 = dsp0; // Fresh Ident of dsp0
  A  = { x -> (dsp0.A0 dsp0 x) }; // Bind variant
  // These dsp1 come from LAMBDA, not Fresh
  D0 = { dsp1x -> (dsp1x.A 1) }; //
};
dsp2 = @{
  dsp1 = dsp1;
  D = { -> (dsp1.D0 dsp1) };
};

@{ Aflt = (dsp1.A 3.1f); AD = (dsp2.D); }
