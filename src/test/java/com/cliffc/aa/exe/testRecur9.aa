// Wrapped ints
// Type: A:*[3]@{ add={ *[INT]@{ B:*[2]@{ $dyn=-; int={ B - int:int64 -> A }; }; $dyn=C; i=int:int64; } - D:*[3]@{ add={ *[INT]@{ E:*[2]@{ $dyn=-; int={ E - int:int64 -> D }; }; $dyn=F; i=int:int64; } - *[]@{ i=int:int64;  ..., } *[]@{ i=int:int64;  ..., } -> D }; i=int:int64; } G:*[3]@{ add={ *[INT]@{ H:*[2]@{ $dyn=-; int={ H - int:int64 -> G }; }; $dyn=I; i=int:int64; } - *[]@{ i=int:int64;  ..., } *[]@{ i=int:int64;  ..., } -> G }; i=int:int64; } -> A }; i=int:int64; }
// Eval: *[3]@{ add=<*[6]@{ _ $dyn=0; i=7; },LAM5>; i=7; }
int = { i ->        // An integer is a struct...
  @{ add = { x y -> // With an 'add' field which is a fcn
       (int (+ x.i y.i)) // ... which unwraps to ints and adds and rewraps
     };
     i = i;         // And with the wrapped int
  }
};
x =(int 3);   // x is 3:int
y =(int 4);   // y is 4:int
(x.add x y)  // Wrapped 7:int
